rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only read/write their own top-level profile doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Same rule applies to every subcollection under this user
      match /actions/{actionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /dailyScores/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /reports/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Anything not explicitly matched above is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}